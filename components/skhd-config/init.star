# components/skhd-config/init.star
#
# platforms: ["macos"]
# after:     ["@stdlib//components/skhd", "@stdlib//bundles/modern-macos"]
#
# Global Ctrl+Option hotkeys that open or focus an app, served by skhd.
# macOS ships no global shortcut for any of these apps, so nothing is shadowed.
#
# The skhdrc is generated, not linked: a binding is written only for an app
# that is installed when the component runs, so an app installed later gets its
# hotkey on the next `meowctl apply`.
#
# skhd needs Accessibility access (System Settings -> Privacy & Security ->
# Accessibility). macOS asks for it the first time the service starts, and no
# hotkey fires until it's granted.

platforms = ["macos"]
after = ["@stdlib//components/skhd", "@stdlib//bundles/modern-macos"]

# (key, app name as `open -a` takes it)
_BINDINGS = [
    ("t", "Ghostty"),
    ("b", "Safari"),
    ("m", "Mail"),
    ("c", "Calendar"),
    ("f", "Finder"),
    ("s", "Slack"),
    ("g", "Telegram"),
    ("o", "Microsoft Outlook"),
]

def _app_dirs(ctx):
    return [
        "/Applications",
        ctx.home + "/Applications",
        "/System/Applications",
        "/System/Library/CoreServices",  # Finder
    ]

def _installed(ctx, app):
    for d in _app_dirs(ctx):
        if ctx.file_exists(d + "/" + app + ".app"):
            return True
    return False

def _skhdrc(ctx):
    return ctx.home + "/.config/skhd/skhdrc"

def _write_config(ctx):
    lines = ["# Generated by dotmeow skhd-config; edits are overwritten on apply.", ""]
    for key, app in _BINDINGS:
        if _installed(ctx, app):
            lines.append("ctrl + alt - " + key + " : open -a \"" + app + "\"")
        else:
            ctx.log("skhd-config: " + app + " not installed, no hotkey")
    ctx.mkdir(ctx.home + "/.config/skhd")
    ctx.write_file(_skhdrc(ctx), "\n".join(lines) + "\n")

def _space_switching(ctx):
    # "When switching to an application, switch to a Space with open windows
    # for the application". Unset means on, so only an explicit 0 is fixed.
    # `defaults read` exits 1 on an unset key; the shell keeps that quiet.
    r = ctx.run("sh", ["-c", "defaults read com.apple.dock workspaces-auto-swoosh 2>/dev/null || true"])
    if r.stdout.strip() == "0":
        ctx.run("defaults", ["write", "com.apple.dock", "workspaces-auto-swoosh", "-bool", "true"])
        ctx.run("killall", ["Dock"])

def _require_skhd(ctx):
    if not ctx.which("skhd"):
        fail("skhd-config: skhd is not on PATH; @stdlib//components/skhd failed to install it (run `brew install koekeishiya/formulae/skhd` to see why)")

def _plist(ctx):
    return ctx.home + "/Library/LaunchAgents/com.koekeishiya.skhd.plist"

def _service(ctx):
    # skhd runs every command through `$SHELL -c`. The service inherits
    # SHELL from the login session, so with fish each hotkey paid for a full
    # config.fish load, about 0.4 s. skhd 0.3.9 has no `.shell` option, so
    # the LaunchAgent pins SHELL=/bin/sh instead. `--restart-service` only
    # kickstarts the job and keeps the old environment; stop and start make
    # launchd read the plist again.
    if not ctx.file_exists(_plist(ctx)):
        ctx.run("skhd", ["--install-service"])
    ctx.run("plutil", ["-replace", "EnvironmentVariables.SHELL", "-string", "/bin/sh", _plist(ctx)])
    ctx.run("skhd", ["--stop-service"])
    ctx.run("skhd", ["--start-service"])

def install(ctx):
    _require_skhd(ctx)
    _write_config(ctx)
    _space_switching(ctx)
    _service(ctx)
    ctx.log("skhd-config: grant skhd Accessibility access if macOS asks for it")

def upgrade(ctx):
    _require_skhd(ctx)
    _write_config(ctx)
    _space_switching(ctx)
    _service(ctx)

def verify(ctx):
    if not ctx.file_exists(_skhdrc(ctx)):
        ctx.log("skhd-config: MISSING " + _skhdrc(ctx))
        return
    r = ctx.run("launchctl", ["list"])
    if "skhd" in r.stdout:
        ctx.log("skhd-config: OK")
    else:
        ctx.log("skhd-config: skhd service not running")

def uninstall(ctx):
    ctx.run("skhd", ["--stop-service"])
    ctx.delete_file(_skhdrc(ctx))
