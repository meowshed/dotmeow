# @file: components/ghostty-config/config
# @brief: Ghostty terminal emulator configuration (macOS)
#
# Only non-default values are set; anything omitted uses Ghostty's default.
# Verified against Ghostty 1.3.1 (`ghostty +validate-config`).

# ============================================================================
# FONT
# ============================================================================
font-family = "JetBrainsMono Nerd Font Mono"
font-style = "SemiBold"
font-size = 14
# -calt disables contextual alternates (ligatures) intentionally.
font-feature = -calt

# ============================================================================
# WINDOW
# ============================================================================
window-width = 120
window-height = 40
window-padding-x = 4
window-padding-y = 4
window-save-state = always

# macOS chrome: transparent titlebar pairs with the glass background below;
# non-native fullscreen keeps the menu bar / notch and Spaces behaving.
macos-titlebar-style = transparent
macos-non-native-fullscreen = true

# ============================================================================
# VISUAL
# ============================================================================
# macOS 26+ native glass material (implies background-blur = true). Cells stay
# opaque (background-opacity default 1.0), so the glass shows through the window
# padding. Lower background-opacity below 1.0 to let it bleed through content.
background-blur = macos-glass-regular
cursor-style-blink = false

# ============================================================================
# SHELL
# ============================================================================
# fish is the login shell; `detect` would find it too, but pin it explicitly.
# All shell-integration-features (cursor, sudo, title, ssh-env, ssh-terminfo,
# path) are enabled by default, so no feature override is needed.
shell-integration = fish

# ============================================================================
# CLIPBOARD
# ============================================================================
# Allow OSC 52 clipboard reads (default is `ask`).
clipboard-read = allow
# Disable auto-copy on selection (Ghostty defaults this to `true`).
copy-on-select = false

# ============================================================================
# INPUT
# ============================================================================
macos-option-as-alt = left
mouse-hide-while-typing = true
# Slow the discrete mouse wheel (default 3); trackpad precision stays at 1.
mouse-scroll-multiplier = 1.0

# ============================================================================
# TERMINAL
# ============================================================================
resize-overlay = always

# ============================================================================
# KEYBINDINGS
# ============================================================================
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+[=previous_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+n=new_window
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+shift+c=copy_url_to_clipboard
keybind = shift+insert=paste_from_clipboard

# ============================================================================
# RENDERING
# ============================================================================
adjust-underline-thickness = 1
adjust-underline-position = 2
adjust-cursor-thickness = 2

# ============================================================================
# THEME
# ============================================================================
# Follows macOS appearance; switches between Latte (light) and Mocha (dark).
theme = "light:Catppuccin Latte,dark:Catppuccin Mocha"
